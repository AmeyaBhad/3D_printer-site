# Copy this file to `.env` and fill in your values.
# Vite reads variables prefixed with VITE_ at build/dev time.

# Backend API base (defaults to http://localhost:8080/api if unset)
# VITE_API_BASE_URL=http://localhost:8080/api

# OAuth Client ID from Google Cloud Console:
#   APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
#   Authorized JavaScript origins must include http://localhost:5173 and http://127.0.0.1:5173
# Leaving this blank disables the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=
